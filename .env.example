# Supabase Postgres (Project Settings > Database).
# DATABASE_URL = pooled connection (port 6543), DIRECT_URL = direct connection (port 5432)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Supabase Realtime & Storage
NEXT_PUBLIC_SUPABASE_URL="https://your-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOi..."

# Auth.js. Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Google OAuth (console.cloud.google.com > APIs & Services > Credentials)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Comma-separated admin emails
ADMIN_EMAILS="microsoftclub@dau.ac.in,your-test-email@dau.ac.in"
